# CodeMorph configuration
# Copy this file to .env and adjust values as needed.

# Source and target languages
CODEMORPH_SOURCE_LANG=python
CODEMORPH_TARGET_LANG=typescript

# Directories
CODEMORPH_SOURCE_DIR=.
# CODEMORPH_OUTPUT_DIR=./migrated-output

# Options
CODEMORPH_DRY_RUN=false
CODEMORPH_VERBOSE=false
CODEMORPH_MAX_WORKERS=4
